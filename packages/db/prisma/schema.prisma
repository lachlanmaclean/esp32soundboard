generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserTier {
  NORMAL
  PRO
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PlaySource {
  WEB
  DEVICE
  DISCORD
}

// A person who has logged into the portal via Discord OAuth2.
model User {
  id              String     @id @default(cuid())
  discordId       String     @unique
  discordUsername String
  discordAvatar   String?
  tier            UserTier   @default(NORMAL)
  status          UserStatus @default(ACTIVE)
  // Version string (see apps/portal/src/lib/changelog.ts) of the newest
  // changelog entry this user has dismissed. Null means never seen one.
  lastSeenChangelogVersion String?
  // Owner-only override: skip showing the changelog popup to this user at
  // all, regardless of version - for accounts where it'd just be noise
  // (e.g. a test account, or someone who asked to stop seeing it).
  changelogMuted           Boolean    @default(false)
  // Null falls back to whichever policy has isDefault = true. Set
  // explicitly on signup (apps/portal/src/lib/auth.ts) rather than left
  // null, but kept nullable so an admin can also "unassign" back to
  // whatever the current default is instead of a fixed one.
  cooldownPolicyId String?
  cooldownPolicy   CooldownPolicy? @relation(fields: [cooldownPolicyId], references: [id], onDelete: SetNull)
  // Set once a user trips their policy's trigger; cleared naturally once
  // it's in the past rather than an explicit un-set step.
  rateLimitedUntil DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  sounds        Sound[]
  devices       Device[]
  presets       Preset[]
  voiceSessions VoiceSession[]
  playEvents    PlayEvent[]

  @@index([cooldownPolicyId])
}

// A rate-limiting policy an admin defines and assigns to users. Exactly one
// policy has isDefault = true at a time (enforced in application code, not
// a DB constraint) - new users are assigned it on signup, and it can never
// be deleted, only have a different policy promoted to replace it.
model CooldownPolicy {
  id   String @id @default(cuid())
  name String

  // Trip condition: this many plays within this many seconds.
  maxSoundsInWindow Int
  windowSeconds     Int
  // Once tripped: this long a wait is required between each play...
  cooldownSeconds Int
  // ...and the limited state itself lasts this long before lifting.
  limitedDurationSeconds Int

  isDefault Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

// One stretch of time a user spent in a Discord voice channel the bot was
// also connected to and active in - the "usage time" the owner admin page
// shows. Started/ended by the bot's own voice-state listener; endedAt is
// null while the session is still ongoing.
model VoiceSession {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  @@index([userId])
}

// One successful sound trigger, from any surface. soundId is null for
// external plays (meme library, future YouTube) that aren't a library Sound
// row - still counts toward "times activated" even without one.
model PlayEvent {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  soundId   String?
  sound     Sound?     @relation(fields: [soundId], references: [id], onDelete: SetNull)
  source    PlaySource
  createdAt DateTime   @default(now())

  @@index([userId])
  @@index([soundId])
}

// One of up to LIBRARY_SOUND_LIMIT sounds in a user's library (not per-server,
// not per-device). Whether/where a sound appears on a soundboard is tracked
// separately by PresetSlot, not on this model - one sound can sit on several
// presets (or none) at once.
model Sound {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  color       String
  icon        String?
  // Path/URL to the stored audio file (local disk or object storage). May be
  // a hardlink into originals/ shared with other Sound rows of the same hash.
  audioUrl    String
  // SHA-256 of the raw uploaded bytes, used to dedupe identical uploads
  // (even across users) onto one physical file instead of storing copies.
  fileHash    String
  // Playback gain as a percentage - 100 is unchanged, 0 is silent, up to 200
  // (2x) for quiet clips. Applied at play time, not baked into the file.
  volume      Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  presetSlots PresetSlot[]
  playEvents  PlayEvent[]

  @@index([userId])
  @@index([fileHash])
}

// A saved soundboard page: a named arrangement of library sounds at fixed
// positions. A user can have several; exactly one is `isActive` at a time,
// and that's the one synced down to their paired physical device (if any).
// Pro accounts get many presets capped at BOARD_SOUND_LIMIT slots each (the
// physical 4x2 grid size); Normal accounts are capped to exactly one preset,
// sized to their library limit instead, rendered as a flexible web-only grid.
model Preset {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots PresetSlot[]

  @@index([userId])
}

// One sound placed at one position within a preset. Position is a flat
// index - the physical device grid renders it row-major (4 columns), the
// Normal-tier flexible grid just wraps it in a CSS grid.
model PresetSlot {
  id       String @id @default(cuid())
  presetId String
  preset   Preset @relation(fields: [presetId], references: [id], onDelete: Cascade)
  position Int
  soundId  String
  sound    Sound  @relation(fields: [soundId], references: [id], onDelete: Cascade)

  @@unique([presetId, position])
  @@index([presetId])
  @@index([soundId])
}

// Audit trail for the owner's "log in as user" admin action - who, whom,
// when. Impersonation is powerful enough (full access to that user's
// account) that it gets a paper trail even with a single trusted admin.
model ImpersonationLog {
  id              String    @id @default(cuid())
  adminDiscordId  String
  targetUserId    String
  startedAt       DateTime  @default(now())
  endedAt         DateTime?

  @@index([targetUserId])
}

// A physical CYD device. Devices can exist unpaired (userId null) between
// factory reset / unbinding and the next pairing.
model Device {
  id                   String    @id @default(cuid())
  // Hardware-generated unique ID the CYD reports on first check-in (its "CUID").
  cuid                 String    @unique
  userId               String?
  user                 User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Short-lived code shown on the device's pairing screen (with QR code).
  // Cleared once pairing completes.
  pairingCode          String?   @unique
  pairingCodeExpiresAt DateTime?
  lastSeenAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
}

// Single-row cache of myinstants.com's trending results, re-scraped at most
// once a day (apps/server/src/api/routes/library.ts) so a page load never
// triggers a live scrape - persisted here instead of in-process memory so
// it survives restarts/redeploys instead of silently resetting.
model TrendingCache {
  id        Int      @id @default(1)
  results   Json
  fetchedAt DateTime @default(now())
}
