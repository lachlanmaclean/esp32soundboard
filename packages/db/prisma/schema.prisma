generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// A person who has logged into the portal via Discord OAuth2.
model User {
  id              String   @id @default(cuid())
  discordId       String   @unique
  discordUsername String
  discordAvatar   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sounds  Sound[]
  devices Device[]
}

// One of up to 30 sounds in a user's library (not per-server, not per-device).
// A subset (onBoard = true, capped separately at BOARD_SOUND_LIMIT) is what
// actually shows up as a button on the CYD grid / web soundboard.
model Sound {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName String
  color       String
  icon        String?
  // Path/URL to the stored audio file (local disk or object storage). May be
  // a hardlink into originals/ shared with other Sound rows of the same hash.
  audioUrl    String
  // SHA-256 of the raw uploaded bytes, used to dedupe identical uploads
  // (even across users) onto one physical file instead of storing copies.
  fileHash    String
  onBoard     Boolean  @default(false)
  // Playback gain as a percentage - 100 is unchanged, 0 is silent, up to 200
  // (2x) for quiet clips. Applied at play time, not baked into the file.
  volume      Int      @default(100)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([fileHash])
}

// A physical CYD device. Devices can exist unpaired (userId null) between
// factory reset / unbinding and the next pairing.
model Device {
  id                   String    @id @default(cuid())
  // Hardware-generated unique ID the CYD reports on first check-in (its "CUID").
  cuid                 String    @unique
  userId               String?
  user                 User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  // Short-lived code shown on the device's pairing screen (with QR code).
  // Cleared once pairing completes.
  pairingCode          String?   @unique
  pairingCodeExpiresAt DateTime?
  lastSeenAt           DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([userId])
}
