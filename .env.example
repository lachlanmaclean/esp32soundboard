# --- Shared / Docker Compose ---
POSTGRES_PASSWORD=changeme
PORTAL_URL=http://localhost:3000

# --- Discord application (Developer Portal) ---
# One app covers both the bot and OAuth2 login.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# --- apps/server ---
